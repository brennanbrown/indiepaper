{
  "name": "examplesite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "hugo --minify",
    "serve": "hugo server --bind 127.0.0.1 --port 1313 --buildDrafts",
    "test": "npm run lint && npm run audit",
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "html-validate public",
    "lint:css": "stylelint 'static/**/*.css'",
    "audit": "npm run audit:lighthouse && npm run audit:accessibility",
    "audit:lighthouse": "echo 'Install Lighthouse CI separately for full audit'",
    "audit:accessibility": "pa11y http://localhost:1313 --sitemap",
    "validate:indieweb": "node scripts/validate-indieweb.js",
    "validate:feeds": "node scripts/validate-feeds.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.54.2",
    "@html-eslint/parser": "^0.54.0",
    "axios": "^1.13.4",
    "eslint": "^9.39.2",
    "html-validate": "^10.7.0",
    "jsdom": "^28.0.0",
    "pa11y": "^9.1.0",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
